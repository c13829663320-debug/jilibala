# ============================================================
# R5 发布域：docker/.env.example —— 部署环境变量清单
# 用法：cd docker && cp .env.example .env 后按需填写。
# 所有占位符（example.com / 空密钥）严禁直接上线。
# ============================================================

# ---------- 对外域名 ----------
# 你的公网域名（nginx server_name / coturn realm / PWA start_url 同源）
DOMAIN=example.com

# ---------- HTTPS 证书 ----------
# 本机存放 fullchain.pem 与 privkey.pem 的目录（compose 挂载到 nginx:/etc/nginx/ssl）
# 推荐 certbot 申请 Let's Encrypt 免费证书
SSL_CERT_PATH=./ssl

# ---------- API ----------
API_PORT=3001

# ---------- WebSocket / 前端连接 ----------
# 浏览器侧 WS 地址（生产为 wss，必须与页面同源 https）
WS_URL=wss://example.com/api/ws

# ---------- WebRTC TURN ----------
# coturn 长期凭证密钥（前端通过服务端 REST API 临时换凭证，勿硬编码到前端）
TURN_SECRET=REPLACE_WITH_REAL_TURN_SECRET
TURN_URI=turn:example.com:3478

# ---------- 上游 AI 网关（留空则走离线降级） ----------
STEPFUN_API_KEY=
TRIPO_API_KEY=

# ---------- 部署账号/资源（备忘，不注入容器） ----------
# 需要准备：一台公网 VPS(≥2C4G)、域名 DNS A 记录指向 VPS、
#           开放端口 80/443/3478/5349/49152-49200/udp、
#           Let's Encrypt 账号、coturn 镜像、Tripo/StepFun 开放平台账号。
