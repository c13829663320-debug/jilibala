# ============================================================
# 叽里呱啦 · BalaBala 部署环境变量示例
# 用法：cp .env.example .env 后按需填写；docker compose 会自动读取同目录 .env
# ============================================================

# ---------- 运行模式 ----------
# Node 运行环境：production / development。容器内固定 production。
NODE_ENV=production
# Fastify 日志级别：fatal / error / warn / info / debug / trace。
LOG_LEVEL=info

# ---------- 端口 ----------
# API 进程监听端口（容器内部）。一般无需修改。
PORT=8787
# 宿主浏览器访问端口（映射到 nginx:80）。访问 http://<服务器IP>:${WEB_PORT}
WEB_PORT=8080

# ---------- 数据持久化 ----------
# SQLite 数据库文件路径（容器内）。已由 compose 挂载到命名卷 balabala_data。
DB_PATH=/data/app.db
# 兼容旧版 JSON 存储路径（当前主存储为 SQLite，这两个仅作兜底）。
BALABALA_CASES_FILE=/data/cases.json
BALABALA_CONTENTS_FILE=/data/contents.json

# ---------- 上游 3D 生成：Tripo ----------
# 在 https://tripo3d.ai 控制台申请；留空则 3D 建模功能走占位/降级。
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi

# ---------- 上游 LLM：StepFun（阶跃星辰）----------
STEPFUN_API_KEY=
STEPFUN_API_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.5-flash

# ---------- 上游 LLM：Evomap ----------
EVOMAP_API_KEY=
EVOMAP_API_BASE_URL=https://api.evomap.ai/v1
EVOMAP_MODEL=evomap-deepseek-v4-flash

# ---------- 并发与限流 ----------
# LLM 全局并发信号量（StepFun 账户并发上限约 5，保守设 4）。
LLM_MAX_CONCURRENCY=4

# ---------- 出网代理（服务器无法直连上游 API 时使用）----------
# 形如 http://host:port；三选一/按需填写。留空表示直连。
# TRIPO_HTTPS_PROXY=http://127.0.0.1:12450
# HTTPS_PROXY=http://127.0.0.1:12450
# HTTP_PROXY=http://127.0.0.1:12450

# ---------- 跨域（保留项）----------
# 当前 API 经 nginx 同源反代，CORS 反射任意来源；如需收紧可在此指定允许的 Origin。
# CORS_ORIGIN=https://your-domain.example.com

# ---------- WebSocket（保留项）----------
# 单实例 WS 连接数上限提示值；当前代码未硬编码限制，按服务器内存/带宽自行规划。
# WS_MAX_CLIENTS=200
