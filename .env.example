TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
STEPFUN_API_KEY=
STEPFUN_API_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.5-flash
PORT=8787
EVOMAP_API_KEY=
EVOMAP_API_BASE_URL=https://api.evomap.ai/v1
EVOMAP_MODEL=evomap-deepseek-v4-flash

# Optional local proxy when Node cannot reach Tripo directly (e.g. Windows proxy)
# TRIPO_HTTPS_PROXY=http://127.0.0.1:12450

# ===== Round4 R4-04: WebRTC 语音 STUN / TURN 配置（前端 Vite 注入） =====
# STUN：免费公共 STUN 即可打通大多数 NAT；留空则使用默认 Google STUN。
# 格式：JSON 数组，元素为 RTCIceServer 对象。
VITE_STUN_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# TURN：对称 NAT（公司网/手机 4G）下 STUN 打不通时用 TURN 中继兜底。
# 部署 coturn 后把下面换成你自己的服务器；长期用建议配 REST API 临时凭证。
# 格式：JSON 数组。示例（占位，请替换）：
# VITE_TURN_SERVERS=[{"urls":["turn:your-turn.example.com:3478","turns:your-turn.example.com:5349"],"username":"balabala","credential":"change-me"}]
VITE_TURN_SERVERS=

# TURN 凭证（静态共享密钥；生产环境推荐用 coturn REST API 生成短期凭证，见 docs/WEBRTC-TURN-GUIDE.md）
# VITE_TURN_USERNAME=balabala
# VITE_TURN_CREDENTIAL=change-me

