{
  "name": "balabala-court",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace apps/api && npm run test --workspace apps/web",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser-smoke": "tsx tests/e2e/browser-signaling.smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.12.0"
  }
}
